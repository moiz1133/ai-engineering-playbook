# Web search
TAVILY_API_KEY=tvly-your-key-here

# Postgres (postgres_query tool)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# File reader
FILE_READER_BASE_DIR=./data

# REST API tool -- SSRF controls
# Comma-separated allowlist. Leave empty to allow any domain not in BLOCKED_DOMAINS.
ALLOWED_DOMAINS=
MAX_RESPONSE_SIZE_MB=10

# with_llm.py example
OPENAI_API_KEY=sk-your-key-here
